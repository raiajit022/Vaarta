# Vaarta Meeting Service — Environment Variables
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In Docker Compose, these are injected via the `env_file` directive.

# Database connection
DB_URL=jdbc:postgresql://postgres:5432/meetings
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret — must match auth-service
JWT_SECRET=super_secret_development_jwt_key_that_is_at_least_32_bytes_long

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Notification Service Integration
NOTIFICATION_SERVICE_URL=http://notification-service:8080
INTERNAL_API_KEY=internal_dev_key_123
