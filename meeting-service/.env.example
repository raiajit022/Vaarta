# Vaarta Auth Service — Environment Variables
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In Docker Compose, these are injected via the `env_file` directive.

# Database connection
# Local dev (running DB in Docker, service on host): jdbc:postgresql://localhost:5432/auth
# Docker Compose (both in Docker): jdbc:postgresql://postgres:5432/auth
DB_URL=jdbc:postgresql://postgres:5432/auth
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret — must be at least 256 bits (32 characters) for HS256
# Use a strong random string in production!
JWT_SECRET=super_secret_development_jwt_key_that_is_at_least_32_bytes_long

# Resend API Key for transactional emails (verification, password reset)
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=noreply@vaarta.com

# Frontend URL (used for CORS and building email links)
# Local dev: http://localhost:5173
# Docker Compose: http://localhost:3000
FRONTEND_URL=http://localhost:3000
