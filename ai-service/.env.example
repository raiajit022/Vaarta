# ─── Azure AI Foundry (Azure OpenAI) — primary provider ────────────────────
# Get these from the Azure AI Foundry portal after deploying a model.
# ENDPOINT is the resource endpoint, NOT the full /chat/completions URL.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key-1-from-the-portal>

# The name YOU typed when creating the deployment — not the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# ─── Direct OpenAI — local fallback only ──────────────────────────────────
# Leave AZURE_OPENAI_ENDPOINT blank to use this path instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Service-to-service ───────────────────────────────────────────────────
INTERNAL_API_KEY=<same value every service shares>
MEETING_SERVICE_URL=http://meeting-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080

# ─── Azure only (unset locally) ───────────────────────────────────────────
# AZURE_CLIENT_ID=<managed identity client id>
# AZURE_KEY_VAULT_URL=https://vaarta-vault-prod.vault.azure.net/
