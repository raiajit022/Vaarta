# ----------------------------------------
# VAARTA MONOREPO - ENVIRONMENT VARIABLES
# ----------------------------------------
# Copy this file to .env:
#   cp .env.example .env
#
# These variables are automatically picked up by docker-compose and 
# injected into the respective microservices.
# ----------------------------------------

# 1. Database Connections
DB_URL=jdbc:postgresql://postgres:5432/postgres
DB_USER=postgres
DB_PASSWORD=postgres

# 2. Security & JWT
JWT_SECRET=super_secret_development_jwt_key_that_is_at_least_32_bytes_long
INTERNAL_API_KEY=internal_dev_key_123

# 3. Microservice Internal URLs (For backend-to-backend communication)
USER_SERVICE_URL=http://user-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080

# 4. LiveKit Configuration
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://livekit:7880

# 5. Frontend Public APIs (Vite embeds these at build time)
VITE_AUTH_API_URL=http://localhost:8081
VITE_USER_API_URL=http://localhost:8082
VITE_MEETING_API_URL=http://localhost:8083
VITE_LIVEKIT_URL=ws://localhost:7880

# 6. Email Service (Resend)
RESEND_API_KEY=re_123456789_mock_key
