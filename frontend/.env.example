# Vaarta Frontend — Environment Variables
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In Docker Compose, these are injected via the `environment:` block.
# For production, set these in your CI/CD pipeline or cloud secret manager.

# Base URL of the auth-service API (no trailing slash)
# Local dev:  http://localhost:8081
# Docker:     http://auth-service:8080   (internal Docker network)
VITE_AUTH_API_URL=http://localhost:8081

# Base URL of the user-service API (added in Phase 2b)
# VITE_USER_API_URL=http://localhost:8082

# Base URL of the meeting-service API (added in Phase 2c)
# VITE_MEETING_API_URL=http://localhost:8083
